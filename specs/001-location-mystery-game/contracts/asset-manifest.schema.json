{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-manifest.schema.json",
  "title": "Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "required", "optional"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "required": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "optional": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
