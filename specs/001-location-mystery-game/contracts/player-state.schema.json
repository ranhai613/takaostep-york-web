{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "player-state.schema.json",
  "title": "Player State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "currentSceneId", "chapterId", "completedEventIds", "reachedSpotIds", "solvedPuzzleIds", "viewedHintIds", "collectedPartIds", "listenedAudioIds", "audioProgress", "q4Order", "endingSeen", "updatedAt"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "currentSceneId": { "type": "string", "minLength": 1 },
    "chapterId": { "type": "string", "minLength": 1 },
    "completedEventIds": { "$ref": "#/$defs/idSet" },
    "reachedSpotIds": { "$ref": "#/$defs/idSet" },
    "solvedPuzzleIds": { "$ref": "#/$defs/idSet" },
    "viewedHintIds": { "$ref": "#/$defs/idSet" },
    "collectedPartIds": { "$ref": "#/$defs/idSet" },
    "listenedAudioIds": { "$ref": "#/$defs/idSet" },
    "audioProgress": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
    "q4Order": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["R", "A", "M", "I"] } },
    "endingSeen": { "type": "boolean" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "idSet": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
